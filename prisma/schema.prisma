// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
}

enum Status {
  TODO
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Team {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())

  members User[]
  tasks   Task[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  tasksCreated  Task[] @relation("TaskCreator")
  tasksAssigned Task[] @relation("TaskAssignee")
}

// Token monouso per verificare l'indirizzo email in fase di registrazione.
// Si salva l'hash del token, mai il valore in chiaro (come per le password).
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  period      Period    @default(DAILY)
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String

  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  @@index([teamId])
  @@index([assigneeId])
}
