// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())

  members    User[]
  projects   Project[]
  objectives Objective[]
  dailies    Daily[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  objectivesCreated  Objective[] @relation("ObjectiveCreator")
  objectivesAssigned Objective[] @relation("ObjectiveAssignee")
  dailiesCreated     Daily[]     @relation("DailyCreator")
  dailiesAssigned    Daily[]     @relation("DailyAssignee")
}

// Token monouso per verificare l'indirizzo email in fase di registrazione.
// Si salva l'hash del token, mai il valore in chiaro (come per le password).
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Contenitore di obiettivi (es. Produzione, Social media, Commerciale).
// Lo crea solo l'amministratore; l'avanzamento è la media dei suoi obiettivi.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  objectives Objective[]

  @@index([teamId])
}

// Obiettivo di un progetto. Avanzamento solo automatico:
// daily completate / daily collegate.
model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  assignee   User   @relation("ObjectiveAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String

  creator   User   @relation("ObjectiveCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  dailies Daily[]

  @@index([teamId])
  @@index([projectId])
}

// Microtask del giorno. Può essere libera (senza obiettivo).
// Se non completata resta visibile nei giorni successivi (carry-over):
// "date" resta il giorno pianificato, così si sa da quanto è in ritardo.
model Daily {
  id          String    @id @default(cuid())
  title       String
  date        DateTime  @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  objectiveId String?

  assignee   User   @relation("DailyAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String

  creator   User   @relation("DailyCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  @@index([teamId, date])
  @@index([assigneeId])
  @@index([objectiveId])
}
