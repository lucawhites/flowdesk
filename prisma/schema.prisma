// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())
  /// Istruzioni libere scritte dall'amministratore, lette dall'agente a ogni esecuzione.
  agentInstructions String?

  members    User[]
  projects   Project[]
  objectives Objective[]
  dailies    Daily[]
  agentRuns  AgentRun[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  // Aree di competenza (es. "Produzione", "CRM"): l'agente pianificatore
  // assegna le daily di un obiettivo a chi ha competenza nella sua area.
  areas         String[]  @default([])

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  objectivesCreated  Objective[] @relation("ObjectiveCreator")
  objectivesAssigned Objective[] @relation("ObjectiveAssignee")
  dailiesCreated     Daily[]     @relation("DailyCreator")
  dailiesAssigned    Daily[]     @relation("DailyAssignee")
}

// Token monouso per verificare l'indirizzo email in fase di registrazione.
// Si salva l'hash del token, mai il valore in chiaro (come per le password).
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Contenitore di obiettivi (es. Produzione, Social media, Commerciale).
// Lo crea solo l'amministratore; l'avanzamento è la media dei suoi obiettivi.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  objectives Objective[]

  @@index([teamId])
}

// Obiettivo di un progetto. Avanzamento automatico = passi completati / passi
// (se non ha passi: daily completate / daily collegate).
// La metrica di risultato (es. 37/200 bracciali) è solo informativa.
model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())

  metricLabel    String?
  metricUnit     String?
  metricTarget   Float?
  metricCurrent  Float?
  // true quando l'utente ha approvato la metrica proposta dall'agente
  metricApproved Boolean @default(false)
  // Focus del mese: solo questi obiettivi generano daily dall'agente.
  inFocus        Boolean @default(false)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  assignee   User   @relation("ObjectiveAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String

  creator   User   @relation("ObjectiveCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  dailies Daily[]
  steps   ObjectiveStep[]

  @@index([teamId])
  @@index([projectId])
}

// Passo concreto di un obiettivo (i "DO" della Project Map), in ordine.
model ObjectiveStep {
  id          String    @id @default(cuid())
  position    Int
  title       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  objectiveId String

  dailies Daily[]

  @@index([objectiveId])
}

// Registro delle esecuzioni dell'agente (pianificazione e revisione).
model AgentRun {
  id           String    @id @default(cuid())
  kind         String    // "plan" | "review"
  status       String    // "ok" | "dry" (prova, nulla salvato) | "error" | "skipped"
  day          DateTime  @db.Date
  model        String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costUsd      Float     @default(0)
  summary      String?
  error        String?
  output       Json?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  dailies Daily[]

  @@index([teamId, day])
}

// Microtask del giorno. Può essere libera (senza obiettivo).
// Se non completata resta visibile nei giorni successivi (carry-over):
// "date" resta il giorno pianificato, così si sa da quanto è in ritardo.
model Daily {
  id          String    @id @default(cuid())
  title       String
  date        DateTime  @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  objectiveId String?

  step   ObjectiveStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  stepId String?

  // Daily create dall'agente pianificatore (modificabili come le altre).
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentRunId String?

  assignee   User   @relation("DailyAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String

  creator   User   @relation("DailyCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  @@index([teamId, date])
  @@index([assigneeId])
  @@index([objectiveId])
}
